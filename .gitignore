# ==========================================
# PURAFRUIT MOBILE - .gitignore (Expo / React Native)
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native Builds (Continuous Native Generation - Expo Prebuild)
/ios/
/android/

# Keystores, Certificates & Mobile Provisioning
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem

# Build artifacts & Binaries
*.apk
*.aab
*.ipa

# Native compilation artifacts
.kotlin/
.gradle/
build/

# Metro Bundler & Cache
.metro-health-check*
*.bundle
*.patch

# Environment variables & secrets (CRITICAL for Supabase & API keys)
.env
.env.*
!.env.example
.env*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Code Coverage
coverage/
.nyc_output/

# TypeScript Cache
*.tsbuildinfo

# IDEs and Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI Assistants & Temporary ide configs
.claude/
.gemini/
.agents/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
